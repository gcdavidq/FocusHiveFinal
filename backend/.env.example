# Copia este archivo como .env y completa los valores.
# URL de PostgreSQL (Neon). Formato SQLAlchemy con driver psycopg2:
DATABASE_URL=postgresql+psycopg2://USUARIO:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Clave para firmar los JWT. Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# True activa el log de SQL en consola. Mantener en False en producción.
DEBUG=False
